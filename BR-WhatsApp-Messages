<!DOCTYPE html>
<html>
<head>
    <title>Copy Messages</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 900px;
            margin: auto;
            padding: 20px;
        }

        .message-box {
            border: 1px solid #ddd;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .header {
            padding: 10px;
            background: #f5f5f5;
            text-align: right;
        }

        .message {
            padding: 15px;
            white-space: pre-wrap;
        }

        button {
            padding: 8px 15px;
            cursor: pointer;
        }
    </style>
</head>

<body>

<h1>My Messages</h1>

<div class="message-box">
    <div class="header">
        <button onclick="copyMessage('msg1')">Copy</button>
    </div>

    <div class="message" id="msg1">
This is my first message.
    </div>
</div>

<div class="message-box">
    <div class="header">
        <button onclick="copyMessage('msg2')">Copy</button>
    </div>

    <div class="message" id="msg2">
This is my second message.
    </div>
</div>

<script>
function copyMessage(id) {
    const text = document.getElementById(id).innerText;

    navigator.clipboard.writeText(text)
        .then(() => alert("Copied!"));
}
</script>

</body>
</html>
